{
  "name": "tripsplit-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "TripSplit - Travel Expense Sharing App",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
