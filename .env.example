# TripSplit Environment Configuration
# Copy this file to .env and fill in your values

# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tripsplit?retryWrites=true&w=majority
# Example for Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/tripsplit
# NOTE: If left empty or commented out, TripSplit automatically uses an embedded in-memory MongoDB!
MONGODB_URI=

# JWT Secret for user session tokens (choose any secure random string)
JWT_SECRET=tripsplit-super-secret-key-change-in-production-2026

# Environment
NODE_ENV=development
